{
	"$schema": "https://unpkg.com/wrangler/config-schema.json",
	"name": "activecompute-site",
	"compatibility_date": "2026-09-30",

	// **Pinned, because account ambiguity is what took this site down.**
	// Wrangler resolves the target account in this order: an explicit `account_id`,
	// then `CLOUDFLARE_ACCOUNT_ID`, then whatever is cached in `.wrangler/cache/`.
	// That cache used to be committed to this repo and held the OLD account — the one
	// the Pages project stayed behind in and the one the `activecompute.co` zone is
	// NOT in — so a deploy would have silently targeted it, failed to claim the
	// Custom Domains, and left the apex exactly as broken as before.
	//
	// This is the Active Compute account, which holds the zone, the Orkestra update
	// feed and the platform Workers. An account id is an identifier, not a credential;
	// this is the documented place for it.
	"account_id": "4afc1c7797b5242e40838466702cd168",

	// **An assets-only Worker: there is deliberately no `main`.**
	//
	// Wrangler accepts a Worker with `assets` and no script, and serves the
	// directory straight from Cloudflare's edge. The site is static — HTML, CSS,
	// one script, some images — so a Worker script would only add a hop and a
	// thing to break. If this ever needs real request handling (a redirect rule, a
	// form endpoint), add `main` then and not before.
	//
	// Replaced Cloudflare Pages on 2026-10-01. Pages is no longer the path for new
	// work — static sites are Workers with static assets. See README.md.
	"assets": {
		// Built by deploy.sh, never committed: it is the repo with `?v=DEV` stamped
		// to the git short SHA. Deploying the repo root instead would ship the
		// literal string `?v=DEV` and break cache-busting for everyone.
		"directory": "./_site",

		// `single-page-application` would be wrong here — this is a multi-file static
		// site, not a client-routed app, and rewriting every miss to index.html would
		// turn a typo'd URL into a 200 and hide broken links from us and from crawlers.
		//
		// **This setting is currently inert, and that is a known gap.** `404-page`
		// serves the nearest `404.html` in the asset directory, and the repo has none,
		// so a miss returns a bare 404 with an empty body — indistinguishable from
		// `"none"`. Someone who mistypes a URL gets a blank page with no branding and
		// no way back. The setting is kept because it is the correct destination: drop
		// a `404.html` in the repo root and it starts working with no config change.
		// Designing that page is tracked separately.
		"not_found_handling": "404-page"
	},

	// Both hostnames, as Custom Domains, so Cloudflare owns the DNS records and the
	// certificates. The apex and `www` are separate records and both must be
	// claimed, or whichever is left over keeps resolving to nothing.
	//
	// Universal SSL covers the apex and one label, so both of these are covered
	// without Advanced Certificate Manager.
	"routes": [
		{ "pattern": "activecompute.co", "custom_domain": true },
		{ "pattern": "www.activecompute.co", "custom_domain": true }
	],

	// Stated rather than inherited. Wrangler derives `workers_dev` from whether any
	// routes exist, so a config that merely *has* routes gets the behaviour we want
	// by accident and loses it the moment someone comments a route out. Writing both
	// out means the site is reachable at its own two hostnames and nowhere else, and
	// a future edit that would expose a second origin has to say so explicitly.
	"workers_dev": false,
	"preview_urls": false,

	"observability": { "enabled": true }
}
